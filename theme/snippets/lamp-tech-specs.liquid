{%- comment -%}
  Technische Daten „Auf einen Blick“ – Kacheln aus Metafeldern (Namespace lamp).
  Variantenwert hat Vorrang vor Produktwert.

  Verwendung: {% render 'lamp-tech-specs', product: product %}
  Optional:   variant, heading (Standard: „Auf einen Blick“)
{%- endcomment -%}
{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  assign vm = v.metafields.lamp
  assign pm = product.metafields.lamp

  assign kelvin = vm.color_temperature_k.value | default: pm.color_temperature_k.value
  assign lumen = vm.luminous_flux_lm.value | default: pm.luminous_flux_lm.value
  assign watt = vm.power_w.value | default: pm.power_w.value
  assign socket = vm.socket.value | default: pm.socket.value
  assign ip = vm.ip_rating.value | default: pm.ip_rating.value
  assign cri = vm.cri_ra.value | default: pm.cri_ra.value
  assign light_color = vm.light_color.value | default: pm.light_color.value
  assign dim_mf = vm.dimmable | default: pm.dimmable
  assign dim_type = vm.dimming_type.value | default: pm.dimming_type.value
  assign smart = vm.smart_protocol.value | default: pm.smart_protocol.value

  assign k_num = kelvin | plus: 0

  if light_color == blank and kelvin != blank
    if k_num <= 3300
      assign light_color = 'Warmweiß'
    elsif k_num <= 5300
      assign light_color = 'Neutralweiß'
    else
      assign light_color = 'Tageslichtweiß'
    endif
  endif

  assign k_swatch = '#FFE3B3'
  if kelvin != blank
    if k_num < 2500
      assign k_swatch = '#FFC58A'
    elsif k_num < 2850
      assign k_swatch = '#FFD29C'
    elsif k_num < 3500
      assign k_swatch = '#FFE0B8'
    elsif k_num < 4500
      assign k_swatch = '#FFF1DC'
    elsif k_num < 5500
      assign k_swatch = '#FFF8EF'
    else
      assign k_swatch = '#EEF3FF'
    endif
  endif

  assign has_any = false
  if kelvin != blank or lumen != blank or watt != blank or socket != blank or ip != blank or dim_mf != blank or smart != blank
    assign has_any = true
  endif
-%}

<div class="lx-specs" data-lamp-swap="specs-{{ product.id }}"{% unless has_any %} hidden{% endunless %}>
  {%- if has_any -%}
    <h2 class="lx-specs__title lx-eyebrow">{{ heading | default: 'Auf einen Blick' }}</h2>
    <ul class="lx-specs__grid" role="list">
      {%- if kelvin != blank or light_color != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Lichtfarbe</span>
            <span class="lx-specs__value">
              <span class="lx-specs__swatch" style="--lx-k: {{ k_swatch }};" aria-hidden="true"></span>
              {%- if kelvin != blank -%}{{ kelvin }} K{%- endif -%}
              {%- if kelvin != blank and light_color != blank %} · {% endif -%}
              {{- light_color -}}
            </span>
          </span>
        </li>
      {%- endif -%}

      {%- if lumen != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2V16h5.2v-.2c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Helligkeit</span>
            <span class="lx-specs__value">{{ lumen }} lm{% if watt != blank %} · {{ watt }} W{% endif %}</span>
          </span>
        </li>
      {%- elsif watt != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Leistung</span>
            <span class="lx-specs__value">{{ watt }} W</span>
          </span>
        </li>
      {%- endif -%}

      {%- if socket != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 3h8v5H8zM7 8h10l-1 5H8zM9 13h6v3l-1 1v2h-4v-2l-1-1z"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Fassung</span>
            <span class="lx-specs__value">{{ socket }}</span>
          </span>
        </li>
      {%- endif -%}

      {%- if dim_mf != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Dimmbar</span>
            <span class="lx-specs__value">
              {%- if dim_mf.value -%}Ja{% if dim_type != blank %} · {{ dim_type | join: ', ' }}{% endif %}{%- else -%}Nein{%- endif -%}
            </span>
          </span>
        </li>
      {%- endif -%}

      {%- if ip != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11Z"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Schutzart</span>
            <span class="lx-specs__value">{{ ip }}</span>
          </span>
        </li>
      {%- endif -%}

      {%- if cri != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="9" cy="10" r="5"/><circle cx="15" cy="10" r="5"/><circle cx="12" cy="15" r="5"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Farbwiedergabe</span>
            <span class="lx-specs__value">Ra {{ cri }}</span>
          </span>
        </li>
      {%- endif -%}

      {%- if smart != blank -%}
        <li class="lx-specs__item">
          <span class="lx-specs__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 12.5a10 10 0 0 1 14 0M8 15.5a6 6 0 0 1 8 0"/><circle cx="12" cy="18.5" r="1" fill="currentColor"/></svg>
          </span>
          <span>
            <span class="lx-specs__label">Smart Home</span>
            <span class="lx-specs__value">{{ smart | join: ', ' }}</span>
          </span>
        </li>
      {%- endif -%}
    </ul>
  {%- endif -%}
</div>
