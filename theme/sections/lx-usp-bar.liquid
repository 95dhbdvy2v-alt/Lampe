{%- comment -%}
  LUMEN – Trust- & USP-Leiste. Mobile: 2 Spalten, Desktop: 4 Spalten.
{%- endcomment -%}
<div
  class="lx-usp color-{{ section.settings.color_scheme }} gradient"
  style="--lx-pt: {{ section.settings.padding_top }}px; --lx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="lx-usp__heading lx-eyebrow">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="lx-usp__list" role="list">
      {%- for block in section.blocks -%}
        <li class="lx-usp__item" {{ block.shopify_attributes }}>
          <span class="lx-usp__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 8h16v14H3zM19 13h6l4 5v4h-10z"/><circle cx="9" cy="24" r="2.5"/><circle cx="24" cy="24" r="2.5"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M6 26C6 13 14 6 27 5c0 13-7 21-19 21"/><path d="M6 26 18 14"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 11h12a6 6 0 0 1 0 12H11"/><path d="m13 6-5 5 5 5"/></svg>
              {%- when 'box' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="m16 4 11 5v14l-11 5-11-5V9z"/><path d="m5 9 11 5 11-5M16 14v14"/><path d="M11 6.5 22 11.5"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M16 4 26 8v7c0 6-4 11-10 13C10 26 6 21 6 15V8z"/><path d="m11.5 16 3 3 6-6"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 7h22v14H14l-6 5v-5H5z"/><path d="M10 12h12M10 16h8"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 25h8M13 28h6M16 4a8 8 0 0 0-4.8 14.4c.8.6 1.3 1.6 1.3 2.6V22h7v-1c0-1 .5-2 1.3-2.6A8 8 0 0 0 16 4Z"/></svg>
            {%- endcase -%}
          </span>
          <span class="lx-usp__text">
            <strong class="lx-usp__title">{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}
              <span class="lx-usp__sub">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .lx-usp { padding: calc(var(--lx-pt) * 0.75) 0 calc(var(--lx-pb) * 0.75); }
  .lx-usp__heading { margin: 0 0 2rem; text-align: center; }
  .lx-usp__list {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.4rem 1.6rem;
    margin: 0; padding: 0; list-style: none;
  }
  .lx-usp__item { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
  .lx-usp__icon { width: 3.2rem; height: 3.2rem; color: var(--lx-brass, #B08D57); }
  .lx-usp__icon svg { width: 100%; height: 100%; }
  .lx-usp__text { display: flex; flex-direction: column; gap: 0.3rem; }
  .lx-usp__title { font-size: 1.3rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  .lx-usp__sub { font-size: 1.3rem; line-height: 1.45; color: rgba(var(--color-foreground), 0.7); }

  @media screen and (min-width: 990px) {
    .lx-usp { padding: var(--lx-pt) 0 var(--lx-pb); }
    .lx-usp__list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3.2rem; }
    .lx-usp__item { flex-direction: row; align-items: flex-start; text-align: left; }
    .lx-usp__item + .lx-usp__item { border-left: 1px solid rgba(var(--color-foreground), 0.12); padding-left: 3.2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LUMEN: USP-Leiste",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (optional)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "bulb",
          "options": [
            { "value": "truck", "label": "Versand" },
            { "value": "leaf", "label": "Energieeffizienz" },
            { "value": "return", "label": "Rückgabe" },
            { "value": "box", "label": "Verpackung" },
            { "value": "shield", "label": "Sicherheit" },
            { "value": "chat", "label": "Beratung" },
            { "value": "bulb", "label": "Glühbirne" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titel", "default": "Schneller Versand" },
        { "type": "text", "id": "text", "label": "Text", "default": "In 1–3 Werktagen bei dir" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUMEN: USP-Leiste",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Schneller Versand", "text": "In 1–3 Werktagen bei dir – DE, AT & CH" } },
        { "type": "usp", "settings": { "icon": "leaf", "title": "Energieeffizient", "text": "LED-Technik mit EU-Energielabel" } },
        { "type": "usp", "settings": { "icon": "return", "title": "30 Tage Rückgabe", "text": "Entspannt zu Hause ausprobieren" } },
        { "type": "usp", "settings": { "icon": "box", "title": "Bruchsicher verpackt", "text": "Glas & Keramik in Spezialkartons" } }
      ]
    }
  ]
}
{% endschema %}
