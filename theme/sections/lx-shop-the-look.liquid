{%- comment -%}
  LUMEN – Shop the Look: Raumbild mit klickbaren Hotspots + Produktliste.
  Hotspot-Position über X/Y (in %) im Theme-Editor einstellen.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  assign img_alt = img.alt | default: section.settings.heading | escape
-%}
<div
  class="lx-stl color-{{ section.settings.color_scheme }} gradient"
  style="--lx-pt: {{ section.settings.padding_top }}px; --lx-pb: {{ section.settings.padding_bottom }}px;"
  data-lx-stl
>
  <div class="page-width lx-stl__inner{% if section.settings.image_position == 'right' %} lx-stl__inner--reverse{% endif %}">
    <div class="lx-stl__media">
      {%- if img != blank -%}
        {{
          img
          | image_url: width: 2000
          | image_tag:
            class: 'lx-stl__img',
            loading: 'lazy',
            alt: img_alt,
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '(min-width: 990px) 60vw, 100vw'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lx-stl__img lx-stl__img--placeholder' }}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div
          class="lx-stl__spot{% if block.settings.x > 60 %} lx-stl__spot--flip{% endif %}{% if block.settings.y > 55 %} lx-stl__spot--up{% endif %}"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
          data-spot="lx-stl-pop-{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="lx-stl__dot"
            aria-expanded="false"
            aria-controls="lx-stl-pop-{{ block.id }}"
            aria-label="{{ p.title | default: 'Produkt' | escape }} anzeigen"
          ></button>
          <div class="lx-stl__pop" id="lx-stl-pop-{{ block.id }}" hidden>
            {%- if p != blank -%}
              <a class="lx-stl__card" href="{{ p.url }}">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'lx-stl__card-img', alt: p.featured_image.alt }}
                {%- endif -%}
                <span class="lx-stl__card-body">
                  <span class="lx-stl__card-title">{{ p.title }}</span>
                  <span class="lx-stl__card-price">{% if p.price_varies %}ab {% endif %}{{ p.price | money }}</span>
                  <span class="lx-stl__card-cta">Ansehen →</span>
                </span>
              </a>
            {%- else -%}
              <span class="lx-stl__card-body"><span class="lx-stl__card-title">Produkt im Theme-Editor wählen</span></span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="lx-stl__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lx-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lx-stl__heading h1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="lx-stl__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <ol class="lx-stl__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <li class="lx-stl__list-item" data-stl-item="lx-stl-pop-{{ block.id }}">
              <a href="{{ p.url }}" class="lx-stl__row">
                <span class="lx-stl__num" aria-hidden="true">{{ forloop.index }}</span>
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'lx-stl__row-img', alt: '' }}
                {%- endif -%}
                <span class="lx-stl__row-body">
                  <span class="lx-stl__card-title">{{ p.title }}</span>
                  <span class="lx-stl__card-price">{% if p.price_varies %}ab {% endif %}{{ p.price | money }}</span>
                </span>
              </a>
              {%- render 'lamp-energy-label', product: p, compact: true -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>

      {%- if section.settings.button_label != blank -%}
        <a class="button button--secondary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .lx-stl { padding: calc(var(--lx-pt) * 0.75) 0 calc(var(--lx-pb) * 0.75); }
  .lx-stl__inner { display: grid; gap: 3.2rem; }
  .lx-stl__media { position: relative; overflow: visible; }
  .lx-stl__img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .lx-stl__img--placeholder { background: rgba(var(--color-foreground), 0.06); }

  .lx-stl__spot { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); z-index: 1; }
  .lx-stl__spot:has(.lx-stl__dot[aria-expanded="true"]) { z-index: 3; }
  .lx-stl__dot {
    position: relative; width: 3.2rem; height: 3.2rem; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
    background: rgba(250, 247, 242, 0.92); box-shadow: 0 0.4rem 1.6rem rgba(0, 0, 0, 0.25);
  }
  .lx-stl__dot::before {
    content: ''; position: absolute; inset: 0; margin: auto; width: 1rem; height: 1rem; border-radius: 50%;
    background: var(--lx-brass, #B08D57); transition: transform 0.3s ease;
  }
  .lx-stl__dot::after {
    content: ''; position: absolute; inset: -0.6rem; border-radius: 50%;
    border: 1px solid rgba(250, 247, 242, 0.8); animation: lx-pulse 2.4s ease-out infinite;
  }
  .lx-stl__dot[aria-expanded="true"]::before,
  .lx-stl__spot.is-highlight .lx-stl__dot::before { transform: scale(1.6); }
  .lx-stl__dot:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  @keyframes lx-pulse { 0% { transform: scale(0.7); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .lx-stl__dot::after { animation: none; } }

  .lx-stl__pop {
    position: absolute; top: calc(100% + 1rem); left: -1.2rem; width: min(26rem, 70vw);
    background: rgb(var(--color-background)); color: rgb(var(--color-foreground));
    box-shadow: 0 1.2rem 4rem rgba(0, 0, 0, 0.2);
  }
  .lx-stl__spot--flip .lx-stl__pop { left: auto; right: -1.2rem; }
  .lx-stl__spot--up .lx-stl__pop { top: auto; bottom: calc(100% + 1rem); }
  .lx-stl__card { display: flex; gap: 1.2rem; padding: 1.2rem; color: inherit; text-decoration: none; }
  .lx-stl__card-img { width: 7.2rem; height: 7.2rem; object-fit: cover; flex: none; }
  .lx-stl__card-body, .lx-stl__row-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .lx-stl__card-body { padding: 0.2rem 0; }
  .lx-stl__card-title { font-size: 1.5rem; line-height: 1.3; }
  .lx-stl__card-price { font-size: 1.4rem; color: rgba(var(--color-foreground), 0.75); }
  .lx-stl__card-cta { margin-top: auto; font-size: 1.2rem; letter-spacing: 0.1em; text-transform: uppercase; }

  .lx-stl__heading { margin: 0.8rem 0 1.6rem; }
  .lx-stl__text { margin-bottom: 2.4rem; }
  .lx-stl__list { margin: 0 0 3.2rem; padding: 0; list-style: none; border-top: 1px solid rgba(var(--color-foreground), 0.12); }
  .lx-stl__list-item { padding: 1.2rem 0; border-bottom: 1px solid rgba(var(--color-foreground), 0.12); transition: background-color 0.3s ease; }
  .lx-stl__list-item.is-active { background: rgba(var(--color-foreground), 0.04); }
  .lx-stl__list-item .lx-energy--compact { margin-left: 4.4rem; }
  .lx-stl__row { display: flex; align-items: center; gap: 1.2rem; color: inherit; text-decoration: none; }
  .lx-stl__num {
    flex: none; display: grid; place-items: center; width: 3.2rem; height: 3.2rem; border-radius: 50%;
    border: 1px solid var(--lx-brass, #B08D57); font-size: 1.3rem;
  }
  .lx-stl__row-img { width: 6.4rem; height: 6.4rem; object-fit: cover; flex: none; }

  @media screen and (min-width: 990px) {
    .lx-stl { padding: var(--lx-pt) 0 var(--lx-pb); }
    .lx-stl__inner { grid-template-columns: 3fr 2fr; align-items: center; gap: 6.4rem; }
    .lx-stl__inner--reverse .lx-stl__media { order: 2; }
    .lx-stl__img { aspect-ratio: 5 / 4; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function setOpen(dot, open) {
      dot.setAttribute('aria-expanded', open ? 'true' : 'false');
      var id = dot.getAttribute('aria-controls');
      var pop = document.getElementById(id);
      if (pop) pop.hidden = !open;
      var item = document.querySelector('[data-stl-item="' + id + '"]');
      if (item) item.classList.toggle('is-active', open);
    }
    function closeAll(except) {
      document.querySelectorAll('.lx-stl__dot[aria-expanded="true"]').forEach(function (d) {
        if (d !== except) setOpen(d, false);
      });
    }
    document.addEventListener('click', function (e) {
      if (e.target.closest('.lx-stl__pop')) return;
      var dot = e.target.closest('.lx-stl__dot');
      closeAll(dot);
      if (dot) setOpen(dot, dot.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll(null);
    });
    // Hover über Produktliste hebt den passenden Hotspot hervor
    ['mouseover', 'mouseout', 'focusin', 'focusout'].forEach(function (type) {
      document.addEventListener(type, function (e) {
        var item = e.target.closest && e.target.closest('[data-stl-item]');
        if (!item) return;
        var spot = document.querySelector('[data-spot="' + item.getAttribute('data-stl-item') + '"]');
        if (spot) spot.classList.toggle('is-highlight', type === 'mouseover' || type === 'focusin');
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LUMEN: Shop the Look",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Raumbild", "info": "Empfohlen: 2000 × 1600 px, Leuchten eingeschaltet" },
    {
      "type": "select", "id": "image_position", "label": "Bildposition (Desktop)", "default": "left",
      "options": [ { "value": "left", "label": "Links" }, { "value": "right", "label": "Rechts" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Dachzeile", "default": "Inspiration" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Shop the Look" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button-Text" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "range", "id": "x", "label": "Horizontal (%)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Vertikal (%)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUMEN: Shop the Look",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 35, "y": 22 } },
        { "type": "hotspot", "settings": { "x": 78, "y": 58 } }
      ]
    }
  ]
}
{% endschema %}
